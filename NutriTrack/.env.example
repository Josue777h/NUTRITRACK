# Configuración de Supabase para NutriTrack
# Copia este archivo a .env.local y completa con tus credenciales reales

# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon key de Supabase (pública, pero necesaria para el cliente)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Opcional: Configuración de entorno
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Configuración de Envío Automático de Correos (EmailJS - Gratis)
# Obtén tus claves gratuitas en https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here